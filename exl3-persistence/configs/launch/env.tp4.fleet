# env.tp4.fleet -- OUR four-Spark fleet, ported from Mia's .env.tp4.example.
#
# Sourced by start-tp4.sh. Mia's file ships placeholder 10.0.0.x addresses and
# an identical NIC/HCA/GID triple on all three workers, with a comment saying so
# ("NCCL cannot use the 10.0.0.x loopback aliases"). Everything below is a real
# value for our fleet, and the two functional gaps her TP4 launcher still has
# (notes/upstream-repo.md §6) are fixed in start-tp4.sh, not papered over here:
#
#   gap 1: her start-tp4.sh serve_env loop omits EXL3_FAT_GROUPED,
#          GLM53_ADAPTIVE_K* and GLM53_DENSE_FP8, so .env.tp4 cannot override
#          them (start.sh forwards all of them). Ours forwards them.
#   gap 2: her per-worker CX7 IF/HCA/GID default to one shared value. Ours are
#          genuinely per-rank, GID included (5/5/3/3 -- they differ across our
#          four hosts, and tonyd2wild's field notes record that a wrong pinned
#          GID fails fast while an unset one hangs NCCL silently for 20 min at
#          96% GPU util / 22 W).
#
# NO SECRET VALUES IN THIS FILE. Tokens are referenced by file path only.

# --- ranks: LAN address (ssh/API) and fabric address (NCCL) ----------------
# rank 0 = node0 = head. Worker-first launch order is 3, 2, 1, then 0.
RANK0_HOST=node0
RANK0_LAN=192.0.2.10
RANK0_FABRIC=198.51.100.1
RANK1_HOST=node1
RANK1_LAN=192.0.2.11
RANK1_FABRIC=198.51.100.2
RANK2_HOST=node2
RANK2_LAN=192.0.2.12
RANK2_FABRIC=198.51.100.3
RANK3_HOST=node3
RANK3_LAN=192.0.2.13
RANK3_FABRIC=198.51.100.4

# SSH targets (start-tp4.sh runs on rank 0 and drives 1..3 over ssh).
RANK1_SSH=user@192.0.2.11
RANK2_SSH=user@192.0.2.12
RANK3_SSH=user@192.0.2.13

# --- fabric: same CX7 port on every node, but the GID index is NOT ---------
RANK0_IB=rocep1s0f1
RANK1_IB=rocep1s0f1
RANK2_IB=rocep1s0f1
RANK3_IB=rocep1s0f1
RANK0_IF=enp1s0f1np1
RANK1_IF=enp1s0f1np1
RANK2_IF=enp1s0f1np1
RANK3_IF=enp1s0f1np1
# Per-node RoCEv2 GID index. Verify before every launch -- the index is not
# stable across link bounces and reboots. preflight() prints each one's gid.
RANK0_GID=5
RANK1_GID=5
RANK2_GID=3
RANK3_GID=3

NCCL_IB_ADDR_RANGE=198.51.100.0/24
NCCL_CROSS_NIC=1
NCCL_DEBUG=WARN

# --- weights: per-node hub directory, mounted at /root/.cache/huggingface/hub
# node0 keeps the canonical copy on its own root ext4 (this path IS local disk
# on node0; it is also what node1 sees over NFS, which is why node1 uses its
# own local copy instead). node2/node3's target path is still occupied by a
# read-only NFS mount from node0, so their verified local copies live in
# hub-local-staging pending an operator swap (notes/staging-audit.md).
RANK0_HUB=/srv/node0-share/huggingface/hub
RANK1_HUB=$HOME/.cache/huggingface/hub
RANK2_HUB=$HOME/.cache/huggingface/hub-local-staging
RANK3_HUB=$HOME/.cache/huggingface/hub-local-staging

# FIX-3 (node3 DFlash2). RANK<N>_HUB2 is a SECOND hub directory mounted
# read-only at /root/.cache/huggingface/hub-secondary and searched after the
# primary. notes/staging-audit.md records node3's DFlash2 drafter as complete
# under ~/.cache/huggingface/hub while its EXL3 weights are in
# hub-local-staging -- the single old mount could see only one of the two, and
# the engine died with `no snapshot for incoai--GLM-5.3-Flash-DFlash2` after a
# full weight load.
#
# Per notes/staging-audit.md (2026-09-10 read-only audit) only rank 3 needs a
# second hub: node0 has both models under /srv/node0-share/huggingface/hub,
# node1 has both under ~/.cache/huggingface/hub, node2 has both under
# hub-local-staging (its DFlash2 rsync completed and verified), and node3 has
# EXL3 under hub-local-staging but DFlash2 under ~/.cache/huggingface/hub. An
# empty HUB2 means "this node has only one hub"; a DECLARED-but-absent HUB2 is a
# hard abort, because docker would otherwise silently create a root-owned empty
# directory and the drafter would go missing again, mid-load.
#
# Per-node override, if you would rather point straight at the drafter snapshot:
#   RANK3_DRAFT_REPO_DIR=/root/.cache/huggingface/hub-secondary/models--incoai--GLM-5.3-Flash-DFlash2/snapshots/<sha>
# (container path; empty means "resolve it from HUB_DIRS").
RANK0_HUB2=
RANK1_HUB2=
RANK2_HUB2=
RANK3_HUB2=/home/user/.cache/huggingface/hub
RANK0_DRAFT_REPO_DIR=
RANK1_DRAFT_REPO_DIR=
RANK2_DRAFT_REPO_DIR=
RANK3_DRAFT_REPO_DIR=

MODEL_REPO=Mia-AiLab/GLM-5.3-Flash-EXL3-TR3-4bpw
DFLASH_REPO=incoai/GLM-5.3-Flash-DFlash2

# --- serve -----------------------------------------------------------------
SERVED_MODEL_NAME=glm-5.3-flash-exl3
TP=4
NNODES=4
PORT=8000
MASTER_PORT=29521
QUANTIZATION=exl3
KV_CACHE_DTYPE=fp8
# Mia's current shipped defaults (.env.example at 1de5c41): 850k / 0.85. 1M
# needs EXL3_FAT_GROUPED=0. These are HER numbers on HER 2-Spark kit -- ours are
# unqualified at TP4 until a boot proves them.
MAX_MODEL_LEN=850000
GPU_MEM_UTIL=0.85
MAX_NUM_SEQS=4
MAX_NUM_BATCHED_TOKENS=7168
ENFORCE_EAGER=1
LIMIT_MM=100
SKIP_MM_PROFILING=1
CHAT_TEMPLATE=/opt/glm53/chat_template.jinja
LANGUAGE_MODEL_ONLY=0

# MANDATORY. With the sparse kpool indexer active, KpoolTailSpec.block_size ==
# index_kpool (4), and offloading/config.py:57-63 asserts every group's
# tokens_per_block % tokens_per_hash == 0. The default tokens_per_hash is the
# gcd of prefix-cacheable group sizes, i.e. the MLA block (>=128), so 4 % 128
# fails and the engine dies at init. prefix_match_unit must also satisfy
# cache_hit_alignment % tokens_per_state == 0, which lands on exactly
# index_kpool. (notes/kill-gate-study.md C1.)
PREFIX_MATCH_UNIT=4

# --- speculative decoding ---------------------------------------------------
SPEC_METHOD=dflash
DFLASH_TOKENS=7
# block_size - 1: the drafter is trained for a block of 8 and one slot is the
# target's own verified token.
DFLASH_DRAFT_TP=4

# --- EXL3 kernel knobs (gap 1: these ARE forwarded to all four ranks) -------
EXL3_FAT_GROUPED=1
EXL3_TEMP_ROWS_FUSED=32
GLM53_INDEXER_WORKSPACE=rightsize
GLM53_SPINWAIT_MS=16
# Both default off in Mia's recipe; both change numerics or scheduling.
GLM53_ADAPTIVE_K=off
GLM53_ADAPTIVE_K_SET=2,4,7
GLM53_DENSE_FP8=off

# --- persistence ------------------------------------------------------------
# on  -> adds --kv-transfer-config for recipe_persistence.native
# off -> engine runs with in-GPU KV only, exactly as Mia ships it
PERSISTENCE=on

# Per-rank disk root, on that node's local NVMe-backed /home. NOT NFS, NOT the
# weights share. recipe_persistence creates disk_root/rank-<N> beneath it and
# takes an EXCLUSIVE lock on it (storage.py:82-105); never point two processes
# at one root. preflight creates a missing root (mkdir -m 0700), then verifies
# the backing filesystem is a local block filesystem via `findmnt -T` and that
# free space is at least PERSIST_MIN_FREE_BYTES.
RANK0_PERSIST_ROOT=/home/user/kv-persist/rank0
RANK1_PERSIST_ROOT=/home/user/kv-persist/rank1
RANK2_PERSIST_ROOT=/home/user/kv-persist/rank2
RANK3_PERSIST_ROOT=/home/user/kv-persist/rank3
# 1,200 GiB. The 1 TB (decimal) quota below plus Limits.free_bytes reserve plus
# headroom for the SQLite index and its rollback journal.
PERSIST_MIN_FREE_BYTES=1288490188800

# Coordinator: each rank binds its OWN listener at RANK<N>_FABRIC:PORT inside
# initialize_from_config. There is no separate daemon, no head-only URL, and
# the launcher renders coordinator_endpoints in rank order 0,1,2,3.
PERSIST_COORDINATOR_PORT=8976
PERSIST_TENANT=glm53-flash-exl3-tp4

# Path ONLY. The bearer token must be a root-owned regular file, mode 0600 (or
# 0400), 32..4096 bytes, with no group/other access; load_auth_token
# (coordinator_http.py:93-124) refuses a literal config field, an env value, an
# argv token, a symlink and a foreign owner. Provision the file yourself from
# your own secret store on each node before launch; this release does not ship
# the private provisioning utility. The launcher never reads, echoes or logs the
# value. /run is tmpfs: re-provision after every node reboot.
PERSIST_TOKEN_FILE=/run/secrets/persistence-token
PERSIST_TOKEN_FILE_HOST=/run/glm53/persistence-token

# --- physical staging ring ---------------------------------------------------
# Conservative initial ring/metadata bounds. These are limits, not results --
# the persistence README is explicit that no staging default is advertised as
# fitting a given context, and that they must be configured after geometry and
# headroom qualification. native.py:242-250 turns staging_bytes/staging_rows
# into rows of a private per-rank pinned CPU tensor.
PERSIST_STAGING_BYTES=4294967296
PERSIST_STAGING_ROWS=64
PERSIST_DISK_IO_THREADS=4

# --- logical metadata credits (NOT allocations) ------------------------------
# The package's own frozen portable defaults, made explicit so nothing is
# implicit in the rendered JSON. native.py:172-173 raises unless the value here
# equals provider.max_pending_keys, so the two must move together.
PERSIST_MAX_PENDING_KEYS=32768
PERSIST_MAX_PENDING_BYTES=64000000000
PERSIST_LOOKUP_KEYS_PER_STEP=8
# SQLite durability policy for the disk KV store (reconstructible cache).
# delete|wal x off|normal|full|extra. WAL+NORMAL measured 0.024 ms per
# lease grant vs 8.7 ms for DELETE+EXTRA (the decode penalty).
PERSIST_SQLITE_JOURNAL_MODE=wal
PERSIST_SQLITE_SYNCHRONOUS=normal
PERSIST_METADATA_WORKERS=2
PERSIST_METADATA_MAX_SUBMITTED=8
PERSIST_METADATA_SHUTDOWN_TIMEOUT=10

# --- bounded coordinator transport -------------------------------------------
# All package defaults EXCEPT the census deadline. coordinator_http.py:1282
# defaults coordinator_startup_timeout to 60 s (the README says 120 s; the code
# is authoritative). The census runs inside the blocking initialize_from_config
# on every rank, i.e. AFTER a ~175 GiB weight load whose duration differs per
# node, so a 60 s all-rank deadline would fail closed on a healthy fleet. 1800 s
# is a deliberate deviation, bounded by the package's own top=3600.
# ***Needs the operator's sign-off before the first PERSISTENCE=on launch.***
PERSIST_COORDINATOR_STARTUP_TIMEOUT=1800
PERSIST_COORDINATOR_RPC_TIMEOUT=10
PERSIST_COORDINATOR_SERVER_THREADS=16
PERSIST_COORDINATOR_MAX_BODY_BYTES=65536
PERSIST_COORDINATOR_CLIENT_POOL=4
PERSIST_COORDINATOR_IDEMPOTENCY_ENTRIES=32768
# Derived value made explicit: max(1, min(30, 0.1*lease_seconds)) with
# lease_seconds=300 (coordinator_http.py:784). Must stay 0 < margin < lease.
PERSIST_COORDINATOR_RENEW_MARGIN=30

# --- rank-local DiskStore limits (storage.py:45-58 Limits) -------------------
# The frozen portable defaults, every field explicit. NOTE: the old
# `disk_quota_bytes` key was DEAD -- that string does not appear anywhere in
# recipe_persistence. The real quota is Limits.quota, and the package default is
# 1 TB decimal (1,000,000,000,000 B), not the 1 TiB the old env file named.
# Constraint (storage.py:71-74): 0 < low < high <= quota, and
# quota > 2*index_bytes.
PERSIST_LIMIT_QUOTA=1000000000000
PERSIST_LIMIT_HIGH=900000000000
PERSIST_LIMIT_LOW=800000000000
PERSIST_LIMIT_INDEX_BYTES=67108864
PERSIST_LIMIT_MAX_OBJECTS=1000000
PERSIST_LIMIT_MAX_LEASES=32768
PERSIST_LIMIT_MAX_OBJECT_BYTES=67108864
PERSIST_LIMIT_FREE_BYTES=1073741824
PERSIST_LIMIT_FREE_INODES=128
PERSIST_LIMIT_LEASE_SECONDS=300
PERSIST_LIMIT_GRACE_SECONDS=60
PERSIST_LIMIT_IO_CHUNK_BYTES=1048576

# --- containers -------------------------------------------------------------
# FIX-4: the tag is NOT the image. IMAGE_ID is the exact
# `docker image inspect --format '{{.Id}}'` of the build this recipe was written
# against, and preflight refuses to launch unless every rank presents it.
#
# >>> AFTER EVERY REBUILD: update IMAGE and IMAGE_ID together, in the same edit,
# >>> and re-record both. A stale IMAGE_ID stops the fleet (by design); a stale
# >>> IMAGE tag with a moving `:latest` would silently serve a different build.
IMAGE=glm53-flash-exl3-tp4-persist:20260910-83252ea89
IMAGE_ID=sha256:6543e3ad71712b13963580e4076f8d391a428e07992d96a6839220c9dd140a85
CONTAINER0=glm53-exl3-tp4-head
CONTAINER1=glm53-exl3-tp4-w1
CONTAINER2=glm53-exl3-tp4-w2
CONTAINER3=glm53-exl3-tp4-w3
READY_TIMEOUT=5400

# --- startup observer (FIX-2) -----------------------------------------------
# OBSERVER=on|off. ON is the default and is what S2-1 needs. With OBSERVER=on
# the launcher exports VLLM_STARTUP_OBSERVER=1 plus the three values
# startup_observer.emit() requires (startup_observer.py:379-394) and bind-mounts
# OBSERVER_DIR_HOST at OBSERVER_DIR on every rank. A missing/short/invalid
# manifest fingerprint aborts the launch -- it never degrades to "no receipts".
OBSERVER=on
OBSERVER_DIR_HOST=/home/user/persistence-receipts/observer
OBSERVER_DIR=/observer-receipts
# The container runs as root and write_record refuses to write a file it does
# not own (startup_observer.py:366-368), so receipts land on the host as
# root:root 0600 inside OBSERVER_DIR_HOST. Read them with sudo, or
# `sudo chown -R user:user <RECEIPTS>/observer` AFTER the run.
# sha256 of context/observer/observer-callsites-83252ea89.manifest.json, the
# manifest for the 4-stage/15-offset call-site port that is baked into the
# image. Verified against the image at preflight (one read-only sha256sum
# container on rank 0); set OBSERVER_VERIFY_IN_IMAGE=0 to skip that container.
OBSERVER_MANIFEST_SHA256=5de9cf56268e81cc11e43a5e24b0480717cb34acf2dbce2222927f98f72dcd24
OBSERVER_MANIFEST_IN_IMAGE=/opt/glm53/observer/observer-callsites-83252ea89.manifest.json
OBSERVER_VERIFY_IN_IMAGE=1

# native.py:111-116 refuses to start unless PYTHONHASHSEED is a fixed decimal
# 0..4294967295 at process start; the RAW string (leading zeroes included) is
# part of the persistence namespace identity, so never "normalise" it.
PYTHONHASHSEED=0
