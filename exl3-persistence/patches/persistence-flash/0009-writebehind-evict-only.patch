+                # holds first (least-copied investment), then still skip
+                # the job this step.
+                released = [
+                    pool.blocks[bid]
+                    for bid in held_now[max(0, len(held_now) - pressure):]
+                ]
+                for bid in held_now[max(0, len(held_now) - pressure):]:
+                    self._held_evictions.pop(bid, None)
+                if released:
+                    pool.return_held_blocks(released)
